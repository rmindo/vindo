  "publishConfig": {
    "access": "public"
  },
  "scripts": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmindo/vindo.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/rmindo/vindo/tree/main/packages/react#readme",
  "keywords": [
    "react"
  ],
  "peerDependencies": {
    "react": "*",
