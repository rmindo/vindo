
{
  "compilerOptions": {
    "baseUrl": "./",
    "strict": true,
    "allowJs": true,
    "outDir": "./src",
    "jsx": "react-jsx",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
  },
  "include": ["./app/**/*"]
}